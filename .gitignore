# **************************************************************************** #
#                                                                              #
#                                  Git Ignore                                  #
#                                                                              #
# **************************************************************************** #

# Build artifacts
*.o
*.a
*.d
*.out
*.exe

# Libft generated files
libft/libft.a
libft/*.o

# Test build artifacts
tests/.build/
tests/tests
tests/*.tmp
tests/*_tmp.txt

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log

# Valgrind / debug outputs
valgrind-out.txt
vgcore.*
core

# Doxygen generated documentation
Doxyfile
html/
latex/

# Editor files
*.swp
*.swo
*.swn
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
